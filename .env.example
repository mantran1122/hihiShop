APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email: MAIL_MAILER=log chỉ ghi ra log, KHÔNG gửi cho khách.
# Muốn khách nhận được mail quên mật khẩu → dùng SMTP thật và kiểm tra bằng:
#   php artisan hihi:mail-check ban@example.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Socialite OAuth
# Google / Facebook OAuth
# Lưu ý: redirect URI phải khớp CHÍNH XÁC với URI đã khai báo trên Google Cloud Console
#   Local:      http://127.0.0.1:8000/auth/google/callback
#   Production: https://<domain>/auth/google/callback
# Mẹo: trên production chỉ cần set APP_URL đúng domain và để trống GOOGLE_REDIRECT_URI,
#       config/services.php sẽ tự ghép APP_URL + '/auth/google/callback'.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://127.0.0.1:8000/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"


# ---------------------------------------------------------------------------
# VietQR (thông tin nhận tiền)
# ---------------------------------------------------------------------------
VIETQR_BANK_ID=MB
VIETQR_BANK_NAME="MB Bank (Ngân hàng Quân Đội)"
VIETQR_ACCOUNT_NO=0988889999
VIETQR_ACCOUNT_NAME="HIHI SHOP"
VIETQR_TEMPLATE=compact2

# ---------------------------------------------------------------------------
# Webhook thanh toán: đặt secret để bật kiểm tra chữ ký HMAC-SHA256 của body.
# Header mặc định: X-Webhook-Signature (hỗ trợ cả dạng "sha256=<hex>").
# Để trống = KHÔNG kiểm tra (chỉ dùng cho dev/demo).
# ---------------------------------------------------------------------------
PAYMENT_WEBHOOK_SECRET=
# PAYMENT_WEBHOOK_HEADER=X-Webhook-Signature
