# ============================================================================
# Mẫu biến môi trường cho môi trường PRODUCTION (Vercel / hihishop.vn)
# Cách dùng: copy thành .env.production (file này KHÔNG commit) để chạy migrate
# từ máy local, đồng thời nhập y hệt các biến này vào Vercel → Settings → Environment Variables.
# ============================================================================

APP_NAME="HIHI Shop"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:PASTE_KEY_TAI_DAY

# Đổi thành domain thật khi deploy (https, không có dấu / ở cuối)
APP_URL=https://hihi-shop.vercel.app

# Log ra stderr để xem trong Vercel → Functions → Logs
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# Database: TiDB Cloud (Serverless hoặc Dedicated)
# - Host dạng: gateway01.<region>.prod.aws.tidbcloud.com
# - Port: 4000
# - Username: <prefix>.root  (xem trong TiDB Cloud → Connect)
# - Bắt buộc TLS → DB_SSL=true, CA đã đóng gói ở storage/certs/tidb-ca.pem
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=hihi_shop
DB_USERNAME=
DB_PASSWORD=
DB_SSL=true
DB_SSL_VERIFY=true
# Nếu TiDB báo lỗi collation khi migrate, đổi sang utf8mb4_general_ci
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ---------------------------------------------------------------------------
# Session / cache / queue
# Serverless không ghi được file lâu dài → dùng database (bảng sessions/cache đã có migration)
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Mail: đổi sang SMTP thật nếu cần gửi mail xác thực / đơn hàng
MAIL_MAILER=log

# ---------------------------------------------------------------------------
# VietQR (thông tin nhận tiền)
# ---------------------------------------------------------------------------
VIETQR_BANK_ID=MB
VIETQR_BANK_NAME="MB Bank (Ngân hàng Quân Đội)"
VIETQR_ACCOUNT_NO=0988889999
VIETQR_ACCOUNT_NAME="HIHI SHOP"
VIETQR_TEMPLATE=compact2

# Webhook thanh toán: BẬT kiểm tra chữ ký HMAC-SHA256 (khuyến nghị cho production).
# Header mặc định X-Webhook-Signature, hỗ trợ dạng "sha256=<hex>".
# Để trống = không kiểm tra chữ ký.
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# OAuth
# KHÔNG set GOOGLE_REDIRECT_URI: config/services.php tự ghép APP_URL + /auth/google/callback
# (URI này phải có trong Google Cloud Console → Authorized redirect URIs)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
